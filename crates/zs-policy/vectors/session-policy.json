{
  "about": "AWS SSM session policies and the 2048-character limit the control plane enforces.",
  "version": 1,
  "frozen": false,
  "context": {},
  "cases": [
    {
      "name": "the_spike_parameter",
      "input": {
        "parameter": "/acme/prod/DB_PASSWORD",
        "region": "ap-southeast-1",
        "role_arn": "arn:aws:iam::123456789012:role/zs-acme-db"
      },
      "expect": {
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ssm:GetParameter\",\"Resource\":\"arn:aws:ssm:ap-southeast-1:123456789012:parameter/acme/prod/DB_PASSWORD\"},{\"Effect\":\"Allow\",\"Action\":\"kms:Decrypt\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"kms:ViaService\":\"ssm.ap-southeast-1.amazonaws.com\"}}}]}",
        "length": 310
      }
    },
    {
      "name": "the_longest_parameter_fits_under_ap_southeast_1",
      "input": {
        "parameter": "",
        "region": "ap-southeast-1",
        "role_arn": "arn:aws:iam::123456789012:role/zs-acme-db"
      },
      "expect": {
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ssm:GetParameter\",\"Resource\":\"arn:aws:ssm:ap-southeast-1:123456789012:\"},{\"Effect\":\"Allow\",\"Action\":\"kms:Decrypt\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"kms:ViaService\":\"ssm.ap-southeast-1.amazonaws.com\"}}}]}",
        "length": 2048
      }
    },
    {
      "name": "the_longest_parameter_fits_under_a_same_length_region_name",
      "input": {
        "parameter": "",
        "region": "ap-southeast-2",
        "role_arn": "arn:aws:iam::123456789012:role/zs-acme-db"
      },
      "expect": {
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ssm:GetParameter\",\"Resource\":\"arn:aws:ssm:ap-southeast-2:123456789012:\"},{\"Effect\":\"Allow\",\"Action\":\"kms:Decrypt\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"kms:ViaService\":\"ssm.ap-southeast-2.amazonaws.com\"}}}]}",
        "length": 2048
      }
    },
    {
      "name": "the_longest_parameter_exceeds_the_limit_under_a_long_region_name",
      "input": {
        "parameter": "",
        "region": "ap-southeast-north-1",
        "role_arn": "arn:aws:iam::123456789012:role/zs-acme-db"
      },
      "expect": {
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ssm:GetParameter\",\"Resource\":\"arn:aws:ssm:ap-southeast-north-1:123456789012:\"},{\"Effect\":\"Allow\",\"Action\":\"kms:Decrypt\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"kms:ViaService\":\"ssm.ap-southeast-north-1.amazonaws.com\"}}}]}",
        "length": 2060
      }
    },
    {
      "name": "a_short_parameter_in_another_account",
      "input": {
        "parameter": "/a",
        "region": "us-gov-west-1",
        "role_arn": "arn:aws:iam::210987654321:role/zs"
      },
      "expect": {
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ssm:GetParameter\",\"Resource\":\"arn:aws:ssm:us-gov-west-1:210987654321:parameter/a\"},{\"Effect\":\"Allow\",\"Action\":\"kms:Decrypt\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"kms:ViaService\":\"ssm.us-gov-west-1.amazonaws.com\"}}}]}",
        "length": 288
      }
    },
    {
      "name": "a_parameter_with_every_allowed_character",
      "input": {
        "parameter": "/acme_1/prod.db-2/KEY",
        "region": "eu-west-1",
        "role_arn": "arn:aws:iam::123456789012:role/zs-acme-db"
      },
      "expect": {
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ssm:GetParameter\",\"Resource\":\"arn:aws:ssm:eu-west-1:123456789012:parameter/acme_1/prod.db-2/KEY\"},{\"Effect\":\"Allow\",\"Action\":\"kms:Decrypt\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"kms:ViaService\":\"ssm.eu-west-1.amazonaws.com\"}}}]}",
        "length": 299
      }
    }
  ]
}
