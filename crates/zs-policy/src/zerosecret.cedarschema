namespace ZeroSecret {
  type GrantKey = {
    resource: String,
    workload: String,
    operation: String,
    environment: String,
  };
  type ScopeKey = {
    resource: String,
    workload: String,
    operation: String,
  };

  entity User {
    grants: Set<GrantKey>,
    scopes: Set<ScopeKey>,
  };

  entity Resource {
    operations: Set<String>,
    project?: String,
  };

  action "use" appliesTo {
    principal: User,
    resource: Resource,
    context: {
      resource_name: String,
      workload: String,
      operation: String,
      scoped: Bool,
      environment?: String,
      project?: String,
    },
  };
}
