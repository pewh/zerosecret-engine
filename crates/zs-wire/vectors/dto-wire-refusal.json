{
  "about": "WireRefusal (spec 5.3): every refusal code the control plane emits (device_unknown, enrolment_expired, subject_mismatch, not_a_member), an unknown field, a wrong-case key, a duplicate key",
  "version": 1,
  "frozen": false,
  "context": {},
  "cases": [
    {
      "name": "accepted",
      "input": "{\"code\": \"device_unknown\"}",
      "expect": {
        "accepted": true,
        "reserialized": "{\"code\":\"device_unknown\"}"
      }
    },
    {
      "name": "accepted_enrolment_expired",
      "input": "{\"code\": \"enrolment_expired\"}",
      "expect": {
        "accepted": true,
        "reserialized": "{\"code\":\"enrolment_expired\"}"
      }
    },
    {
      "name": "accepted_subject_mismatch",
      "input": "{\"code\": \"subject_mismatch\"}",
      "expect": {
        "accepted": true,
        "reserialized": "{\"code\":\"subject_mismatch\"}"
      }
    },
    {
      "name": "accepted_not_a_member",
      "input": "{\"code\": \"not_a_member\"}",
      "expect": {
        "accepted": true,
        "reserialized": "{\"code\":\"not_a_member\"}"
      }
    },
    {
      "name": "unknown_field_is_ignored",
      "input": "{\"code\": \"not_a_member\", \"subject\": \"alice@example.com\", \"detail\": \"member\"}",
      "expect": {
        "accepted": true,
        "reserialized": "{\"code\":\"not_a_member\",\"subject\":\"alice@example.com\"}"
      }
    },
    {
      "name": "wrong_case_key_is_refused",
      "input": "{\"Code\": \"device_unknown\"}",
      "expect": {
        "accepted": false
      }
    },
    {
      "name": "duplicate_key_is_refused",
      "input": "{\"code\":\"device_unknown\",\"code\":\"not_a_member\"}",
      "expect": {
        "accepted": false
      }
    }
  ]
}
